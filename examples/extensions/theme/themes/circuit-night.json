{
  "$schema": "https://axoneditor.com/schemas/theme/v0.1.0.json",
  "id": "example-circuit-night",
  "name": "Circuit Night Example",
  "appearance": "dark",
  "ui": {
    "background": "#101318",
    "status_bar.background": "#080a0d",
    "title_bar.background": "#080a0d",
    "toolbar.background": "#0c0f13",
    "sidebar.background": "#0c0f13",
    "sidebar.hover_background": "#181d24",
    "sidebar.border": "#29313b",
    "tab.active_background": "#151a20",
    "panel.background": "#0c0f13",
    "panel.border": "#29313b",
    "panel.overlay_hover": "#181d24",
    "editor.foreground": "#d7dde5",
    "editor.background": "#101318",
    "editor.gutter.background": "#101318",
    "terminal.background": "#080a0d",
    "terminal.foreground": "#d7dde5",
    "syntax.comment": "#77808c",
    "syntax.keyword": "#ff6b8a",
    "syntax.string": "#8bd49c",
    "syntax.number": "#f2cc60",
    "syntax.type": "#e6a96b",
    "syntax.function": "#6cb6ff",
    "syntax.method": "#56d4c2",
    "syntax.class": "#e6a96b",
    "syntax.interface": "#c8a6ff",
    "syntax.variable": "#d7dde5",
    "syntax.parameter": "#ffad66",
    "syntax.property": "#7dcfff",
    "syntax.constant": "#ff7a90",
    "syntax.operator": "#a7b0bd",
    "syntax.bracket": "#b4bdc9",
    "syntax.import": "#ff6b8a",
    "syntax.tag": "#56d4c2",
    "syntax.attribute": "#f2cc60"
  },
  "syntax": {
    "comment": { "color": "#77808c", "fontStyle": "italic" },
    "keyword": { "color": "#ff6b8a" },
    "string": { "color": "#8bd49c" },
    "number": { "color": "#f2cc60" },
    "type": { "color": "#e6a96b" },
    "function": { "color": "#6cb6ff" },
    "function.method": { "color": "#56d4c2" },
    "variable": { "color": "#d7dde5" },
    "variable.parameter": { "color": "#ffad66" },
    "variable.member": { "color": "#7dcfff" },
    "operator": { "color": "#a7b0bd" },
    "punctuation": { "color": "#b4bdc9" }
  },
  "terminal": {
    "ansi.black": "#080a0d",
    "ansi.red": "#ff6b8a",
    "ansi.green": "#8bd49c",
    "ansi.yellow": "#f2cc60",
    "ansi.blue": "#6cb6ff",
    "ansi.magenta": "#c8a6ff",
    "ansi.cyan": "#56d4c2",
    "ansi.white": "#d7dde5"
  },
  "monaco": {
    "editor.lineHighlightBackground": "#151a20",
    "editor.selectionBackground": "#29415f80",
    "editorLineNumber.foreground": "#58616d",
    "editorLineNumber.activeForeground": "#d7dde5",
    "editorCursor.foreground": "#6cb6ff",
    "editorIndentGuide.background1": "#29313b",
    "editorIndentGuide.activeBackground1": "#58616d",
    "editorWidget.background": "#151a20",
    "editorWidget.border": "#29313b",
    "editorSuggestWidget.background": "#151a20",
    "editorSuggestWidget.border": "#29313b",
    "editorSuggestWidget.selectedBackground": "#202731",
    "editorSuggestWidget.highlightForeground": "#6cb6ff",
    "focusBorder": "#6cb6ff"
  }
}
